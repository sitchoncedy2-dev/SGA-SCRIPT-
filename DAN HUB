local function getEquippedTool()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and not string.find(string.lower(tool.Name), "punch") then return tool end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and not string.find(string.lower(item.Name), "punch") then
                char.Humanoid:EquipTool(item)
                return item
            end
        end
    end
    return nil
end

local function equipPunch()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char then return end
    local punch = char:FindFirstChild("Punch") or (backpack and backpack:FindFirstChild("Punch"))
    if punch and punch.Parent == backpack then
        char.Humanoid:EquipTool(punch)
    end
    return punch
end

